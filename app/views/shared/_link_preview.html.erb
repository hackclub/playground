<%# What a shared link unfurls into: the name, the tagline, and a banner of
    the logo, some pets, and the goals over the desktop's wallpaper. The same
    for every visitor, so nothing from an account shows. The image's host
    comes from the request. A page of its own, as the guide, can pass its own
    title, line, and picture, and the picture's size with it. %>
<% title = local_assigns.fetch(:title, "playground") %>
<% description = local_assigns.fetch(:description, "make a desktop pet, get cool merch! playground is a Hack Club program where you code a pet that lives on your screen.") %>
<% image = image_url(local_assigns.fetch(:image, "opengraph.jpg")) %>
<% image_width = local_assigns.fetch(:image_width, 1200) %>
<% image_height = local_assigns.fetch(:image_height, 675) %>
<% image_alt = local_assigns.fetch(:image_alt, "The Hack Club playground logo, a pet rock, screenshots of desktop pets, and drawings of a sticker sheet, a keychain, and a shirt, over a blue sky and a green hill. The words: learn how to make a desktop pet! ship cool desktop pet, we ship you merch. 2h, stickersheet. 5h, keychain. 10h, very cool shirt. by froppii and armand.") %>
<meta name="description" content="<%= description %>">
<meta name="theme-color" content="#3a70b8">
<meta property="og:type" content="website">
<meta property="og:site_name" content="playground">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= request.base_url + request.path %>">
<meta property="og:image" content="<%= image %>">
<meta property="og:image:width" content="<%= image_width %>">
<meta property="og:image:height" content="<%= image_height %>">
<meta property="og:image:alt" content="<%= image_alt %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= image %>">
<meta name="twitter:image:alt" content="<%= image_alt %>">
