<%# Plausible's snippet for this site. PLAUSIBLE_SRC is the site's script URL from plausible.io. Off when unset. %>
<% if ENV["PLAUSIBLE_SRC"].present? %>
  <script async src="<%= ENV["PLAUSIBLE_SRC"] %>"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
<% end %>
