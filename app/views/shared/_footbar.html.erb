<%# Hack Club's required links, and who made playground. On the new site's
    own pages (classic: true), a user with the new site on can switch this
    browser to the old desktop, last in the row: in view on every page, but
    asked about first, so never by accident. %>
<% classic = local_assigns[:classic] && current_user&.new_site? %>
<footer class="footbar">
  <p>
    <a href="https://hackclub.com">Hack Club</a> ·
    <a href="https://hackclub.com/privacy-and-terms">Terms &amp; Privacy</a> ·
    <a href="https://forms.hackclub.com/bounty">Fulfillment</a> ·
    <a href="https://security.hackclub.com">Security</a><% if classic %> ·
    <%= link_to "the old desktop →", classic_path, class: "footbar-classic", aria: { haspopup: "dialog" },
                data: { controller: "classic-switch", action: "classic-switch#open" } %><% end %>
  </p>
  <%# Each name links its Slack profile. %>
  <p class="muted">made with &lt;3 by <%= link_to "@froppii", "https://hackclub.enterprise.slack.com/team/U07SX29CECA", target: "_blank", rel: "noopener" %> and <%= link_to "@armand", ApplicationHelper::SPONSOR_URL, target: "_blank", rel: "noopener" %></p>
</footer>
<% if classic %><%= render "shared/classic_dialog" %><% end %>
