<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>playground</title>
    <%= render "shared/icons" %>
    <%# The desktop never renders inside one of its own windows: if a redirect
        lands it in a frame, it takes over the whole window instead. %>
    <script>if (window.top !== window.self) window.top.location.replace(window.location.href)</script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/link_preview" %>
    <%= stylesheet_link_tag "landing" %>
    <%= render "shared/plausible" %>
  </head>
  <body>
    <%= yield %><%= render "landing/back_to_new_site" if back_to_new_site? %>
    <%= javascript_importmap_tags "landing" %>
  </body>
</html>
