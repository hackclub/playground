<% turbo_exempts_page_from_preview %>
<%# The ship list's own page: in a tab, and in the pet's ship window on the
    desktop, which asks with window=1. There the window's title names the pet,
    and the page tells the desktop what it saves. %>
<% unless params[:window] %><p><%= link_to "← #{@project.name}", @project %></p><% end %>
<section class="panel" data-controller="ship-window"
         data-action="ship-checks:saving->ship-window#saving ship-checks:saved->ship-window#saved screenshot-upload:changed->ship-window#changed turbo:submit-end->ship-window#submitted">
  <h2>ship <%= @project.name %></h2><%= render "ship_checks" %>
</section>
