<% content_for :title, "edit #{@project.name}" %>
<% turbo_exempts_page_from_preview %>
<%# The pet's edit page, a window like the pet's card on my pets. Its form
    ends with save, cancel, and, for a pet that never shipped, delete, which
    asks first on a page of its own. %>
<p><%= link_to "← my pets", pet_card_path(@project) %></p>
<section class="pet-window page-window" aria-labelledby="edit-title">
  <div class="pet-titlebar"><h2 class="pet-title" id="edit-title">edit <%= @project.name %></h2></div>
  <div class="pet-pane page-pane"><%= render "form", project: @project %></div>
</section>
