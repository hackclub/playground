<%# Under the guide: on the left a button to the step before, and on the
    right a button to the step after, each with the step's name. The first
    step has no button back, and the last none on. %>
<nav class="guide-pager" aria-label="the step before and the step after">
  <% if (back = @step.previous) %>
    <%= link_to guide_page_path(back), class: "btn guide-prev", rel: "prev", data: { action: "guide-pager#go" } do %><span aria-hidden="true">←</span> <span class="visually-hidden">previous step:</span> <%= back.name %><% end %>
  <% end %>
  <% if (on = @step.following) %>
    <%= link_to guide_page_path(on), class: "btn primary guide-next", rel: "next", data: { action: "guide-pager#go" } do %><span class="visually-hidden">next step:</span> <%= on.name %> <span aria-hidden="true">→</span><% end %>
  <% end %>
</nav>
