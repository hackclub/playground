<%# The guide's outline, left of it on a wide screen: every step, and under
    the step that shows, its sections, which outline_controller.js lists
    from the headings. %>
<div class="hub-outline" aria-label="the guide's outline" data-controller="outline" data-outline-article-value="#guide">
  <ol>
    <% GuidePage.all.each do |step| %>
      <li class="outline-step">
        <%= link_to guide_step_path(step), aria: { current: ("page" if step == @step) }, data: { action: "guide-pager#go" } do %><span class="outline-number"><%= step.number %></span> <%= guide_step_name(step) %><% end %>
        <% if step == @step %><ol data-outline-target="sections"></ol><% end %>
      </li>
    <% end %>
  </ol>
</div>
