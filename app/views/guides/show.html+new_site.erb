<% content_for :title, [ (@step.name unless @step == GuidePage.first), "Build a desktop pet in Godot" ].compact.join(" · ") %>
<%= render "guides/old_links" %>
<%= render "guides/reopen" %>
<% content_for :head, guide_progress_tag %>
<%# The guide, centered, one step at a time, with buttons under it to the
    step before and the step after. On its left, the next step and the
    guide's outline. On its right, a signed-in participant's hours. It
    counts, with no name, which sections this browser reaches (GuideSections).
    Between the step and its buttons, the rock asks a participant how
    playground is going (NpsHelper#nps_rock). %>
<div class="hub" data-controller="guide-pager guide-place guide-progress" <%= tag.attributes(data: guide_progress_data("new_site")) %>
     data-guide-place-key-value="<%= guide_place_key %>" data-guide-place-steps-value="<%= GuidePage.all.map(&:slug).to_json %>"
     data-guide-place-step-value="<%= @step.slug %>" data-guide-place-path-value="<%= guide_step_path(@step) %>">
  <nav class="hub-left" aria-label="where to go">
    <% if current_user %><%= render "guides/side_frame", part: "next" %><% end %>
    <%= render "guides/outline" %>
  </nav>
  <div class="hub-main">
    <%= render "guides/article" %>
    <%= nps_rock %>
    <%= render "guides/pager" %>
  </div>
  <% if current_user %>
    <aside class="hub-right" aria-label="your hours"><%= render "guides/side_frame", part: "side" %></aside>
  <% end %>
</div>
