<%# Left of the guide, above its outline: the one thing a signed-in
    participant should do next. %>
<%# It hides while its part of the guide is on screen (next_step_controller.js).
    A step about one pet names it, and with two pets or more, switches it. A
    step that comes from how far the reader has read goes on to the furthest
    step this browser read, never back (NextStep). %>
<% step = @hub.next_step %>
<%= tag.section class: "side-card side-next", aria: { labelledby: "next-title" },
                data: { controller: "next-step", next_step_place_value: guide_place_key, next_step_steps_value: guide_steps_for_scripts.to_json,
                        next_step_progress_value: step.progress.to_h.to_json, next_step_later_value: step.later.to_h.to_json } do %>
  <p class="side-label">your next step</p>
  <h2 id="next-title" data-next-step-target="title"><%= step.title %></h2>
  <% if step.pet %>
    <%= render "active_pets/switch", pet: step.pet, frame: "hub-next", origin: (@step && "#{@step.path}#hub-next"), just_set: @just_set %>
  <% end %>
  <p data-next-step-target="detail"><%= step.detail %></p>
  <%= link_to step.action, step.href, class: "btn primary", data: { next_step_target: "link" } %>
<% end %>
