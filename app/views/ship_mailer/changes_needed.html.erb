<div style="font-family: sans-serif; font-size: 16px; line-height: 1.5; color: #222; max-width: 520px;">
  <p>[[ARMAND: greeting]] <%= @name %></p>
  <p>[[ARMAND: changes body]]</p>
  <p><strong>Pet:</strong> <%= @pet_name %></p>
  <p><strong>What the reviewer asked for:</strong></p>
  <blockquote style="margin: 0 0 16px; padding-left: 12px; border-left: 3px solid #ccc; white-space: pre-wrap;"><%= @feedback %></blockquote>
  <p><a href="<%= @pet_url %>"><%= @pet_url %></a></p>
  <p>[[ARMAND: sign-off]]</p>
</div>
