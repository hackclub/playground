<% queue_path = @stage == "review" ? admin_review_path(skip: @ship.id) : admin_fraud_path(skip: @ship.id) %>
<header class="itemhead">
  <div>
    <h1><%= ship_name(@ship) %> <span class="muted">ship #<%= @ship.number %></span></h1>
    <p>
      by <%= link_to @user.display_name, admin_person_path(@user) %> ·
      <%= state_badge(@ship.state) %> · review <%= state_badge(@ship.review_status) %> · fraud <%= state_badge(@ship.fraud_status) %> ·
      shipped <%= time_ago_in_words(@ship.created_at) %> ago
    </p>
  </div>
  <div class="row">
    <%= link_to "review", admin_ship_path(@ship, stage: "review", flow: params[:flow]), class: "btn #{"primary" if @stage == "review"}" %>
    <%= link_to "fraud", admin_ship_path(@ship, stage: "fraud", flow: params[:flow]), class: "btn #{"primary" if @stage == "fraud"}" %>
    <% unless flow? %><%= link_to "skip", queue_path, class: "btn", data: { shortcut: "n" } %><kbd>n</kbd><% end %>
  </div>
</header>
<%= render "claim", claim: @claim, held: @held, ship: @ship, stage: @stage %>
<% if @ship.sent_back_possible? %>
  <details class="panel" id="send-back" <%= "open" if params[:reason].present? %>>
    <summary><h2 class="inline">send back to review</h2></summary>
    <%= form_with url: send_back_admin_ship_path(@ship, flow: params[:flow]), class: "stack" do %>
      <p class="muted">review approved this ship and the fraud check has not run. Sending it back clears the review and the checklist, and the participant gets no message.</p>
      <label>reason <span class="muted">required</span>
        <%= text_area_tag :reason, params[:reason], rows: 2, required: true %></label>
      <div class="row"><button class="btn danger" data-confirm="Send this ship back to review?">send back to review</button></div>
    <% end %>
  </details>
<% end %>
<% if @send_backs&.any? %>
  <section class="panel">
    <h2>sent back to review</h2>
    <ul class="events">
      <% @send_backs.each do |e| %>
        <li><span class="muted"><%= e.created_at.to_fs(:short) %></span> <%= e.actor&.display_name %>: <%= e.data["reason"] %>
          <span class="muted">(earlier review by <%= e.data["reviewer_name"] || "unknown" %>, <%= hours(e.data["review_seconds"]) %> approved<%= ", #{e.data["review_judgement"]}" if e.data["review_judgement"].present? %>)</span></li>
      <% end %>
    </ul>
  </section>
<% end %>

<div class="columns">
  <aside class="col side">
    <section class="panel">
      <h2>participant</h2>
      <p><strong><%= @user.display_name %></strong><br><%= @user.email %><br>
        <% if @user.slack_id %>slack <%= link_to @user.slack_id, "https://hackclub.slack.com/team/#{@user.slack_id}", target: "_blank" %><br><% end %>
        <%= @user.eligible? ? "✓ verified, eligible" : "✗ #{@user.verification_status || "unverified"}" %>
        <% if @user.banned? %><br><span class="badge badge-banned">banned</span> <%= @user.ban_reason %><% end %>
      </p>
      <p>Hackatime <strong><%= @ship.snapshot["hackatime_user_id"] %></strong> · trust
        <span class="badge badge-<%= { "red" => "banned", "yellow" => "pending", "green" => "approved" }[@user.hackatime_trust_level] || "draft" %>"><%= @user.hackatime_trust_level || "unknown" %></span></p>
    </section>
    <section class="panel">
      <h2>hours</h2>
      <table class="kv">
        <% @ship.snapshot.fetch("projects", {}).reject { |name, _| Hackatime.ignored?(name) }.each do |name, sec| %>
          <tr><td><%= name %></td><td><%= hours(sec) %></td><td class="muted"><%= @live&.projects&.key?(name) ? "now #{hours(@live.projects[name])}" : "" %></td></tr>
        <% end %>
        <tr><td>tracked at ship</td><td><%= hours(@ship.snapshot["tracked_seconds"]) %></td><td></td></tr>
        <% if @ship.snapshot["previously_claimed_seconds"].to_i.positive? %>
          <tr><td>earlier ships</td><td>− <%= hours(@ship.snapshot["previously_claimed_seconds"]) %></td><td></td></tr>
        <% end %>
        <tr class="total"><td>claimed</td><td><%= hours(@ship.claimed_seconds) %></td><td></td></tr>
        <% if @ship.review_seconds %><tr><td>review approved</td><td><%= hours(@ship.review_seconds) %></td><td></td></tr><% end %>
        <% if @ship.approved_seconds %><tr class="total"><td>final approved</td><td><%= hours(@ship.approved_seconds) %></td><td></td></tr><% end %>
      </table>
      <p class="muted">art counts at most <%= Ship::ART_CAP_PERCENT %>% of approved hours. art arrives through Lapse, linked to one of these projects.</p>
    </section>
    <section class="panel">
      <h2>Lapses</h2>
      <% lapses = Array(@ship.snapshot["lapses"]) %>
      <% if @ship.snapshot["lapse_error"] %>
        <p class="banner">Lapses unavailable: <%= @ship.snapshot["lapse_error"] %></p>
      <% elsif !@ship.snapshot.key?("lapses") %>
        <p class="muted">this ship was taken before Lapse lookup existed.</p>
      <% elsif lapses.empty? %>
        <p class="muted">no Lapse time on these projects.</p>
      <% else %>
        <% share = @ship.claimed_seconds.positive? ? (100.0 * @ship.snapshot["lapse_seconds"].to_i / @ship.claimed_seconds).round : 0 %>
        <p>art <strong><%= hours(@ship.snapshot["lapse_seconds"]) %></strong> of <%= hours(@ship.claimed_seconds) %> claimed ·
          <strong class="<%= "late" if share > Ship::ART_CAP_PERCENT %>"><%= share %>%</strong> <span class="muted">(cap <%= Ship::ART_CAP_PERCENT %>%)</span></p>
        <ul class="events">
          <% lapses.each do |l| %>
            <li><%= link_to l["title"].presence || l["id"], l["url"], target: "_blank", rel: "noopener" %> <span class="muted"><%= hours(l["duration"]) %> · <%= l["project"] %></span></li>
          <% end %>
        </ul>
      <% end %>
    </section>
    <% if Array(@ship.snapshot["warnings"]).any? %>
      <section class="panel warnbox">
        <h2>warnings</h2>
        <ul><% @ship.snapshot["warnings"].each do |w| %><li>! <%= w %></li><% end %></ul>
      </section>
    <% end %>
    <% if @duplicates&.any? %>
      <section class="panel warnbox">
        <h2>same repo elsewhere</h2>
        <ul><% @duplicates.each do |p| %><li><%= link_to p.name, admin_person_path(p.user) %> by <%= p.user.display_name %></li><% end %></ul>
      </section>
    <% end %>
    <% if @shared_hackatime&.any? %>
      <section class="panel warnbox">
        <h2>same Hackatime account elsewhere</h2>
        <ul><% @shared_hackatime.each do |u| %><li><%= link_to u.display_name, admin_person_path(u) %></li><% end %></ul>
      </section>
    <% end %>
    <section class="panel">
      <h2>other ships</h2>
      <% if @other_ships.empty? %><p class="muted">none</p><% end %>
      <ul class="events">
        <% @other_ships.each do |s| %>
          <li><%= link_to "#{ship_name(s)} ##{s.number}", admin_ship_path(s) %> <%= state_badge(s.state) %> <%= hours(s.approved_seconds || s.claimed_seconds) %></li>
        <% end %>
      </ul>
    </section>
  </aside>

  <main class="col main">
    <section class="panel">
      <h2>links</h2>
      <p class="links">
        <%= link_to "code", @ship.snapshot["code_url"], target: "_blank", rel: "noopener" if @ship.snapshot["code_url"] %>
        <%= link_to "shipped link", @ship.snapshot["playable_url"], target: "_blank", rel: "noopener" if @ship.snapshot["playable_url"] %>
        <%= link_to "ship message", @ship.snapshot["ship_message_url"], target: "_blank", rel: "noopener" if @ship.snapshot["ship_message_url"] %>
        <%# The participant's own page, by their Hackatime id, when there is one. %>
        <% hackatime_id = @ship.snapshot["hackatime_user_id"].presence || @user&.hackatime_user_id.presence %>
        <%= link_to "Telescreen", (hackatime_id ? "https://telescreen.hackclub.com/subjects/#{ERB::Util.url_encode(hackatime_id.to_s)}" : "https://telescreen.hackclub.com"), target: "_blank", rel: "noopener" %>
        <%= link_to "Lapse review", "https://telescreen.hackclub.com/workbench/lapse", target: "_blank", rel: "noopener" %>
      </p>
      <% if (release = @ship.snapshot["release"]) %>
        <p>release <strong><%= release["tag"] %></strong>:
          <%= release["assets"].map { "#{it["name"]} (#{number_to_human_size(it["size"])})" }.join(", ").presence || "no files" %></p>
      <% end %>
      <% if @repo %>
        <p class="muted"><%= @repo.full_name %> · <%= pluralize(@repo.commits, "commit") %> · last push <%= @repo.pushed_at&.first(10) %> · ★ <%= @repo.stars %></p>
      <% elsif @ship.snapshot["code_url"].present? %>
        <%# Code off GitHub has no README or commits to show: read it at its link. %>
        <p class="muted">no GitHub data. the code is at <%= link_to @ship.snapshot["code_url"], @ship.snapshot["code_url"], target: "_blank", rel: "noopener" %></p>
      <% end %>
      <%# Every screenshot the ship was taken with, cover first. An older ship
          has only its one. %>
      <% shots = ShipSnapshot.screenshot_urls(@ship) %>
      <% shots.each.with_index(1) do |url, number| %>
        <img class="shot" src="<%= url %>" alt="screenshot <%= number %> of <%= shots.size %>">
      <% end %>
      <p><%= @ship.snapshot["description"] %></p>
      <% if (edited_at = @snapshot.edited_at) %>
        <p class="muted" id="snapshot-edited">edited by <%= @snapshot.edited_by&.display_name || "an admin" %>
          <%= time_tag edited_at, "#{time_ago_in_words(edited_at)} ago", title: edited_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></p>
      <% end %>
    </section>
    <%= render "snapshot_edit", ship: @ship, snapshot: @snapshot, stage: @stage %>

    <% if @stage == "review" %>
      <% if @readme %>
        <details class="panel" open><summary><h2 class="inline">README</h2></summary>
          <div class="readme"><%= readme_html(@readme, repo: @project.github_repo) %></div></details>
      <% end %>
      <% if @repo %>
        <details class="panel"><summary><h2 class="inline">recent commits</h2></summary>
          <ul class="events"><% @commits.each do |c| %><li><code><%= c["sha"] %></code> <%= c["date"]&.first(10) %> <%= c["message"] %></li><% end %></ul>
        </details>
      <% end %>

      <section class="panel" data-controller="checklist" data-checklist-url-value="<%= checklist_admin_ship_path(@ship) %>">
        <h2>checklist</h2>
        <% { "runs" => "the shipped build runs, or the site loads", "is_pet" => "it is a desktop pet", "not_ai" => "the pet is not AI generated",
             "readme" => "the README explains how to install and run it", "hours_fit" => "the hours fit the scope", "art_cap" => "art is at most #{Ship::ART_CAP_PERCENT}% of the hours",
             "not_double" => "not already shipped to another YSWS" }.each do |key, label| %>
          <label class="tick"><input type="checkbox" name="<%= key %>" <%= "checked" if @ship.review_checklist[key] %> data-action="checklist#save" <%= "disabled" unless @ship.review_status == "pending" %>> <%= label %></label>
        <% end %>
      </section>

      <% if @ship.review_status == "pending" && @ship.pending? %>
        <section class="panel">
          <h2>verdict</h2>
          <% if @stardance == :shipped %>
            <p class="banner"><%= StardanceRepos::MESSAGE %> <%= stardance_links(@stardance_ids) %> Approve is off. Request changes or reject.</p>
          <% elsif @stardance == :unknown %>
            <p class="muted">Could not check whether this repo is shipped on Stardance.</p>
          <% end %>
          <%# The presets fill in shares of the claimed hours that are not quarter hours, so the field's step is only for its arrows. %>
          <% h = ->(seconds) { (seconds / 3600.0).round(2) } %>
          <% art = @ship.art_claimed_seconds.positive? %>
          <% coding_cap = @ship.ai_cap_seconds %>
          <% art_start = @ship.art_allowed_seconds(h.(coding_cap) * 3600) %>
          <%# A ship sent back opens with its earlier review. What was typed before an error wins, then that review, then the defaults. %>
          <% earlier = @send_backs&.last&.data || {} %>
          <% coding_now = params[:approved_hours] || (earlier["review_coding_seconds"] ? [ h.(earlier["review_coding_seconds"]), h.(coding_cap) ].min : h.(coding_cap)) %>
          <% art_limit = @ship.art_allowed_seconds(coding_now.to_f * 3600) %>
          <% art_now = params[:approved_art_hours] || (earlier["review_art_seconds"] ? [ h.(earlier["review_art_seconds"]), h.(art_limit) ].min : h.(art_start)) %>
          <%= form_with url: review_admin_ship_path(@ship, flow: params[:flow]), class: "stack", id: "verdict", html: { novalidate: true },
                data: { controller: "deflate", deflate_claimed_value: h.(@ship.coding_claimed_seconds), deflate_cap_value: h.(coding_cap),
                        deflate_art_claimed_value: h.(@ship.art_claimed_seconds), deflate_art_percent_value: Ship::ART_CAP_PERCENT } do %>
            <% if @ship.snapshot["ai_coding_seconds"].nil? %>
              <p class="banner">ai coding time unknown, check Hackatime. no cap applies.</p>
            <% end %>
            <ul class="muted" id="breakdown">
              <li>coding claimed <%= hours(@ship.coding_claimed_seconds) %></li>
              <% if @ship.snapshot["ai_coding_seconds"] && @ship.ai_coding_seconds.positive? %>
                <li>ai coding: <%= hours(@ship.ai_coding_seconds) %>, counts at most a third. coding caps at <%= h.(coding_cap) %>.</li>
              <% elsif @ship.snapshot["ai_coding_seconds"] %>
                <li>ai coding: none.</li>
              <% end %>
              <% if art %>
                <li>art claimed (Lapse) <%= hours(@ship.art_claimed_seconds) %>. art counts at most <%= Ship::ART_CAP_PERCENT %>% of the total, so at most <strong data-deflate-target="artMax"><%= h.(@ship.art_max_seconds(coding_cap)) %></strong>h with this coding.</li>
              <% end %>
              <li>total <strong data-deflate-target="total"><%= (coding_now.to_f + (art ? art_now.to_f : 0)).round(2) %></strong>h</li>
            </ul>
            <label>approved coding hours <span class="muted">claimed <%= h.(@ship.coding_claimed_seconds) %>. deflate when the evidence says less.</span>
              <%= number_field_tag :approved_hours, coding_now, step: 0.25, min: 0, max: h.(coding_cap), data: { shortcut: "h", deflate_target: "hours", action: "input->deflate#changed" } %></label>
            <div class="row" role="group" aria-label="deflate coding to a share of the claimed coding hours">
              <span class="muted">deflate coding to</span>
              <% [ 15, 30, 50, 75 ].each do |percent| %>
                <button type="button" class="btn" data-percent="<%= percent %>" data-action="deflate#set"><%= percent %>% · <%= h.(@ship.coding_claimed_seconds * percent / 100.0) %>h</button>
              <% end %>
            </div>
            <% if art %>
              <label>approved art hours <span class="muted">claimed <%= h.(@ship.art_claimed_seconds) %>.</span>
                <%= number_field_tag :approved_art_hours, art_now, step: 0.25, min: 0, max: h.(@ship.art_claimed_seconds), data: { deflate_target: "art", action: "input->deflate#changedArt" } %></label>
              <p class="muted" data-deflate-target="hold" <%= "hidden" unless @ship.art_claimed_seconds > @ship.art_max_seconds(h.(coding_cap) * 3600) %>>art held at <%= Ship::ART_CAP_PERCENT %>% of the total.</p>
              <div class="row" role="group" aria-label="deflate art to a share of the claimed art hours">
                <span class="muted">deflate art to</span>
                <% [ 15, 30, 50, 75 ].each do |percent| %>
                  <button type="button" class="btn" data-art-percent="<%= percent %>" data-action="deflate#setArt"><%= percent %>% · <%= h.(@ship.art_claimed_seconds * percent / 100.0) %>h</button>
                <% end %>
              </div>
            <% end %>
            <label>why deflated <span class="muted">required when you approve less coding or art than the rules allow. the ai cut and the art hold need none.</span>
              <%= text_area_tag :deflation_reason, params[:deflation_reason] || earlier["review_deflation_reason"], rows: 2 %></label>
            <label>specific technical features <span class="muted">internal record for spot-checkers, so no praise or encouragement. name the features that explain the hours, like custom jumping physics, a save file, a tray menu. if AI was used, note the submitter's experience. for changes or reject, say what is missing.</span>
              <%= text_area_tag :judgement, params[:judgement] || earlier["review_judgement"], rows: 3, data: { shortcut: "j" } %></label>
            <label>note to the participant <span class="muted">shown to them. required for changes needed.</span>
              <%= text_area_tag :feedback, params[:feedback] || earlier["review_feedback"], rows: 2, data: { shortcut: "f" } %></label>
            <label>evidence <span class="muted">required only for fraud: reject and ban. write what shows the fraud.</span>
              <%= text_area_tag :notes, params[:notes], rows: 2 %></label>
            <div class="row">
              <button class="btn primary" name="verdict" value="approve" data-shortcut="a" data-shortcut-confirm <%= "disabled" if @stardance == :shipped %>>approve</button><kbd>a a</kbd>
              <button class="btn" name="verdict" value="changes" data-shortcut="c" data-shortcut-confirm>changes needed</button><kbd>c c</kbd>
              <button class="btn danger" name="verdict" value="reject" data-shortcut="r" data-shortcut-confirm>reject</button><kbd>r r</kbd>
              <button class="btn danger primary" name="verdict" value="ban" data-shortcut="b" data-shortcut-confirm>fraud: reject and ban</button><kbd>b b</kbd>
            </div>
            <p class="muted"><kbd>h</kbd> hours <kbd>j</kbd> judgement <kbd>f</kbd> note · press a verdict key twice</p>
          <% end %>
        </section>
      <% else %>
        <section class="panel"><h2>review</h2>
          <p><%= state_badge(@ship.review_status) %> by <%= @ship.reviewer&.display_name %> <%= @ship.reviewed_at && "#{time_ago_in_words(@ship.reviewed_at)} ago" %></p>
          <p><strong>judgement:</strong> <%= @ship.review_judgement %></p>
          <% if @ship.review_feedback.present? %><p><strong>to participant:</strong> <%= @ship.review_feedback %></p><% end %>
        </section>
      <% end %>
    <% else %>
      <section class="panel">
        <h2>review said</h2>
        <p><%= state_badge(@ship.review_status) %> <%= hours(@ship.review_seconds) if @ship.review_seconds %> by <%= @ship.reviewer&.display_name || "nobody yet" %></p>
        <p><%= @ship.review_judgement %></p>
      </section>
      <section class="panel">
        <h2>fraud checks</h2>
        <ul class="checks">
          <li class="<%= @user.hackatime_red? ? "fail" : "ok" %>"><span class="icon"><%= @user.hackatime_red? ? "✗" : "✓" %></span> Hackatime trust level: <%= @user.hackatime_trust_level || "unknown" %></li>
          <li class="<%= @duplicates&.any? ? "warn" : "ok" %>"><span class="icon"><%= @duplicates&.any? ? "!" : "✓" %></span> repo not shipped by another playground participant</li>
          <li class="<%= @shared_hackatime&.any? ? "warn" : "ok" %>"><span class="icon"><%= @shared_hackatime&.any? ? "!" : "✓" %></span> Hackatime account not linked to another playground participant</li>
          <%= render "unified_check", result: @unified, code_url: @ship.snapshot["code_url"] %>
          <li class="warn"><span class="icon">?</span> watch the Lapses in Telescreen and deduct AFK time</li>
        </ul>
      </section>
      <% if @ship.fraud_status == "pending" && @ship.pending? %>
        <section class="panel">
          <h2>fraud verdict</h2>
          <%= form_with url: fraud_admin_ship_path(@ship, flow: params[:flow]), class: "stack" do %>
            <label>deduct hours <span class="muted">0.25 steps, of <%= (@ship.review_seconds.to_i / 3600.0).round(2) %> approved by review</span>
              <%= number_field_tag :deduct_hours, params[:deduct_hours] || 0, step: 0.25, min: 0, max: (@ship.review_seconds.to_i / 3600.0).round(2), data: { shortcut: "d" } %></label>
            <label>notes <span class="muted">required for a deduction or a ban</span>
              <%= text_area_tag :notes, params[:notes], rows: 3, data: { shortcut: "j" } %></label>
            <div class="row">
              <button class="btn primary" name="verdict" value="pass" data-shortcut="p" data-shortcut-confirm>pass</button><kbd>p p</kbd>
              <button class="btn" name="verdict" value="deduct" data-shortcut="x" data-shortcut-confirm>pass with deduction</button><kbd>x x</kbd>
              <button class="btn danger primary" name="verdict" value="ban" data-shortcut="b" data-shortcut-confirm>fraud: reject and ban</button><kbd>b b</kbd>
            </div>
          <% end %>
        </section>
      <% elsif @ship.fraud_status != "waiting" %>
        <section class="panel"><h2>fraud</h2>
          <p><%= state_badge(@ship.fraud_status) %> by <%= @ship.fraud_reviewer&.display_name %>. <%= "deducted #{hours(@ship.fraud_deduction_seconds)}." if @ship.fraud_deduction_seconds.positive? %> <%= @ship.fraud_notes %></p>
        </section>
      <% else %>
        <p class="banner">fraud waits until review approves this ship.</p>
      <% end %>
    <% end %>

    <% if @justification %>
      <details class="panel"><summary><h2 class="inline">justification for Airtable</h2></summary><pre class="just"><%= @justification %></pre></details>
    <% end %>
  </main>
</div>
